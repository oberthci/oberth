{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "runnerImagePrefixes",
    "replicaCount",
    "auditAnchor",
    "service",
    "persistence",
    "tls",
    "ssh",
    "upstream",
    "cache",
    "resources",
    "podAnnotations",
    "podLabels",
    "compatibility"
  ],
  "properties": {
    "statusProbes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstreamIntervalSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600,
          "default": 60
        },
        "clusterIntervalSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600,
          "default": 60
        },
        "secretStoreIntervalSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600,
          "default": 60
        },
        "upstreamFailureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        }
      }
    },
    "clientEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "description": "Advertised client endpoints persisted on the Service for install verification; empty fields use Service discovery.",
      "properties": {
        "host": {
          "type": "string",
          "maxLength": 253
        },
        "sshPort": {
          "type": "string",
          "pattern": "^$|^[1-9][0-9]{0,4}$"
        },
        "httpsPort": {
          "type": "string",
          "pattern": "^$|^[1-9][0-9]{0,4}$"
        }
      }
    },
    "uplinkTokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultTTL": {
          "type": "string",
          "minLength": 1,
          "description": "New uplink bearer lifetime; positive Go duration, at most maxTTL. Default 2160h (90 days)."
        },
        "maxTTL": {
          "type": "string",
          "minLength": 1,
          "description": "Maximum new uplink bearer lifetime; positive Go duration, hard ceiling 8760h (365 days)."
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional Prometheus Operator ServiceMonitor for the admin-only /metrics endpoint.",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$",
              "default": "60s"
            },
            "additionalLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "bearerTokenSecretName": {
              "type": "string",
              "description": "Secret in the release namespace holding a metrics-scoped uplink token (oberth uplink add --scope metrics)."
            },
            "bearerTokenSecretKey": {
              "type": "string",
              "minLength": 1,
              "default": "token"
            },
            "caConfigMapName": {
              "type": "string",
              "description": "ConfigMap in the release namespace holding the CA the server certificate chains to."
            },
            "caConfigMapKey": {
              "type": "string",
              "minLength": 1,
              "default": "ca.crt"
            },
            "serverName": {
              "type": "string",
              "description": "TLS server name; empty is <fullname>.<namespace>.svc."
            }
          }
        }
      }
    },
    "utilityImage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\s]+$"
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "runnerImagePrefixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^[^\\s\"'\\\\]+$"
      }
    },
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "kubernetesClient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38
        },
        "burst": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assist": {
      "type": "object",
      "additionalProperties": false,
      "description": "Agent-assisted CI continuation: opted-in credential-free branch CI steps park a failed retry for run_hold_* tools. Off by default; assisted runs are never green evidence.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "holdTTL": {
          "type": "string",
          "pattern": "^(([0-9]+h)([0-9]+m)?([0-9]+s)?|([0-9]+m)([0-9]+s)?|[0-9]+s)$",
          "description": "How long an idle unreleased hold waits for the agent before the server abandons it; a hold with an agent action ages from its last action, at most 2x this TTL; the held Pod deadline is the step budget plus 2x this TTL. A Go duration in whole seconds such as 20m or 1h30m, at most 4h."
        },
        "maxConcurrentHolds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "execTimeout": {
          "type": "string",
          "pattern": "^\\+?(([0-9]+(\\.[0-9]+)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$",
          "description": "Deadline of one run_hold_exec command, a Go duration such as 90s or 1m30s; at most 15m."
        },
        "execOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 4194304
        },
        "patchMaxBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "patchMaxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "scratchBytes": {
          "type": "integer",
          "minimum": -1,
          "maximum": 68719476736,
          "description": "Ephemeral storage in bytes added to a held attempt's main container request and limit: its Go caches move to private scratch, so the continued command rebuilds cold on the node's disk. Default 8Gi (8589934592); -1 adds none; at most 64Gi."
        }
      }
    },
    "agentEvents": {
      "type": "object",
      "additionalProperties": false,
      "description": "MCP agent loop: durable agent events, native Argo lock history and MCP push stream bounds (docs/agent-events.md).",
      "properties": {
        "retention": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "syncRetention": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "interval": {
          "type": "string",
          "pattern": "^[0-9]+(s|m)$",
          "description": "Sweep period, 2s..5m."
        },
        "lockWaitThreshold": {
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$"
        },
        "maxStreamsPerToken": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxBacklog": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "heartbeat": {
          "type": "string",
          "pattern": "^[0-9]+(s|m)$",
          "description": "Keepalive interval, 1s..5m."
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    },
    "schedules": {
      "type": "object",
      "additionalProperties": false,
      "description": "Repository cron schedule limits.",
      "properties": {
        "minInterval": {
          "type": "string",
          "pattern": "^\\+?(([0-9]+(\\.[0-9]+)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
        },
        "maxEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "pushBannerURL": {
      "type": "string",
      "description": "Optional HTTPS dashboard URL echoed to every accepted git push as remote: watch output. Empty disables the line.",
      "pattern": "^(|https://.+)$"
    },
    "auditAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tsaURL",
        "tsaInsecureHTTP",
        "rekorURL",
        "rekorInsecureHTTP",
        "interval",
        "maxAge",
        "rootsSecret",
        "rekorCA",
        "rekorPublicKey",
        "tsaCA",
        "acceptWitnessChainReset",
        "acceptWitnessGenesis"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "tsaInsecureHTTP": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "tsaURL": {
                "pattern": "^$|^https://[^/?#@\\s]+(?:[/?][^#\\s]*)?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rekorInsecureHTTP": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "rekorURL": {
                "pattern": "^$|^https://[^/?#@\\s]+(?:[/?][^#\\s]*)?$"
              }
            }
          }
        }
      ],
      "properties": {
        "tsaURL": {
          "type": "string",
          "description": "RFC 3161 timestamp authority HTTPS URL. Empty (the default) disables external timestamps; the local audit hash chain always runs. HTTPS is required unless tsaInsecureHTTP is enabled for development.",
          "pattern": "^$|^https?://[^/?#@\\s]+(?:[/?][^#\\s]*)?$"
        },
        "tsaInsecureHTTP": {
          "type": "boolean",
          "description": "DEVELOPMENT ONLY: allow a plain-HTTP TSA URL."
        },
        "rekorURL": {
          "type": "string",
          "description": "Rekor transparency log URL. Empty (the default) disables external witness publication and startup witness recovery; the local audit hash chain always runs. HTTPS is required unless rekorInsecureHTTP is enabled for development.",
          "pattern": "^$|^https?://[^/?#@\\s]+(?:[/?][^#\\s]*)?$"
        },
        "rekorInsecureHTTP": {
          "type": "boolean",
          "description": "DEVELOPMENT ONLY: allow a plain-HTTP Rekor URL."
        },
        "interval": {
          "$ref": "#/definitions/duration"
        },
        "maxAge": {
          "$ref": "#/definitions/duration"
        },
        "gateTimeout": {
          "$ref": "#/definitions/duration"
        },
        "verifyTimeout": {
          "$ref": "#/definitions/duration"
        },
        "rootsSecret": {
          "$ref": "#/definitions/optionalKubernetesName"
        },
        "rekorCA": {
          "type": "string",
          "description": "Optional PEM bundle pinning the Rekor HTTPS TLS trust anchors (public material, delivered via ConfigMap)."
        },
        "rekorPublicKey": {
          "type": "string",
          "description": "Optional PKIX PEM public key pinning the Rekor log identity instead of Sigstore TUF (public material, delivered via ConfigMap).",
          "pattern": "^$|^-----BEGIN PUBLIC KEY-----\\n(?:[A-Za-z0-9+/]{4}\\n?)+(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?\\n-----END PUBLIC KEY-----\\n?$"
        },
        "tsaCA": {
          "type": "string",
          "description": "Optional PEM bundle pinning the TSA HTTPS TLS trust anchors (public material, delivered via ConfigMap)."
        },
        "acceptWitnessChainReset": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{64}$|^[0-9a-f]{80}$"
        },
        "acceptWitnessGenesis": {
          "type": "string",
          "pattern": "^$|^[1-9][0-9]{0,18}:[0-9a-f]{64}$"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sshPort",
        "httpsPort",
        "sshNodePort",
        "httpsNodePort"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "NodePort",
            "LoadBalancer",
            "ClusterIP"
          ]
        },
        "sshPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Service port for SSH. Under LoadBalancer this is the port svclb binds on the host, so it defaults to 2222 to avoid the host's own sshd; 22 is correct on a node dedicated to Oberth."
        },
        "httpsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Service port for HTTPS/MCP. Under LoadBalancer this is the port svclb binds on the host."
        },
        "sshNodePort": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 32767,
          "description": "Node-wide SSH NodePort for NodePort/LoadBalancer services. Defaults to 30022 and is unused for ClusterIP."
        },
        "httpsNodePort": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 32767,
          "description": "Node-wide HTTPS/MCP NodePort for NodePort/LoadBalancer services. Defaults to 30443 and is unused for ClusterIP."
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim",
        "storageClassName",
        "size"
      ],
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^([1-9][0-9]*Gi|[1-9][0-9]*Ti)$"
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "extraDNSNames": {
          "type": "array",
          "description": "Additional DNS names the generated server certificate is issued for, beyond the in-cluster ones. A client reaching the server on any other name hits a hostname mismatch, which no trust anchor can fix. Ignored when tls.existingSecret is set, and applied only when the certificate is generated.",
          "items": {
            "type": "string"
          }
        },
        "extraIPs": {
          "type": "array",
          "description": "Additional IP addresses the generated server certificate is issued for. An address reached as an IP needs an IP SAN; a DNS name will not match it.",
          "items": {
            "type": "string"
          }
        },
        "pki": {
          "type": "object",
          "additionalProperties": false,
          "description": "Short-lived server certificates from the installer-managed, name-constrained CA in OpenBao's PKI engine. Clients pin the CA; the server renews its leaf in place. Set by oberth install --install-secretstore.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mount": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
            },
            "ttl": {
              "type": "string",
              "pattern": "^$|^[0-9]+[smh]$"
            }
          }
        }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostKey"
      ],
      "properties": {
        "hostKey": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ],
          "properties": {
            "existingSecret": {
              "$ref": "#/definitions/optionalKubernetesName"
            }
          }
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "baseURL",
        "keyFile",
        "knownHostsKey"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 53,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "description": "Upstream name: DNS-1123 label (lowercase alphanumerics and hyphens, no leading/trailing hyphen, max 53 chars). Must match app.ValidateUpstreamName."
        },
        "baseURL": {
          "type": "string",
          "pattern": "^ssh://[^\\s]+$"
        },
        "keyFile": {
          "$ref": "#/definitions/secretDataKey"
        },
        "knownHostsKey": {
          "$ref": "#/definitions/secretDataKey"
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ciRoot",
        "releaseRoot"
      ],
      "properties": {
        "ciRoot": {
          "type": "string",
          "pattern": "^/[^\\s]*[^/\\s]$"
        },
        "releaseRoot": {
          "type": "string",
          "pattern": "^/[^\\s]*[^/\\s]$"
        }
      }
    },
    "resources": {
      "$ref": "#/definitions/resources"
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Egress isolation for the pipeline namespace. Default-deny with targeted allowlist for DNS, HTTPS (443/6443), and the secret store.",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Create a NetworkPolicy in the pipeline namespace restricting egress. Disable on clusters without a NetworkPolicy-capable CNI."
        },
        "dnsNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "description": "DNS resolver Pod namespace. Default kube-system, including old reused values."
        },
        "dnsAnyDestination": {
          "type": "boolean",
          "description": "Explicitly allow DNS to any destination for host-networked/node-local resolvers. Default false."
        },
        "pipelineIngress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "description": "Restrict pipeline listeners to same-namespace Pods and this release's server Pod. Default true, including old reused values."
        },
        "vault": {
          "type": "object",
          "additionalProperties": false,
          "description": "Secret store egress destination. In-cluster: set namespace (default openbao). External: set externalCIDRs. Port defaults to 8200, consistent with argo.vault.address.",
          "properties": {
            "namespace": {
              "type": "string",
              "description": "Namespace where the secret store runs (used as a namespaceSelector label match). Default: openbao."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "Secret store port. Default: 8200."
            },
            "externalCIDRs": {
              "type": "array",
              "description": "CIDRs for an external secret store (e.g. 10.0.1.5/32). When set, namespace is ignored and ipBlock rules are rendered instead.",
              "items": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
              }
            }
          }
        },
        "inNamespacePorts": {
          "type": "array",
          "description": "TCP ports on which pipeline pods may reach other pods in the same namespace (e.g. a Docker API shim for Testcontainers). Ignored when inNamespaceAllPorts is true.",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "inNamespaceAllPorts": {
          "type": "boolean",
          "description": "Allow pipeline pods to reach any pod in the same namespace on any port. Broader than inNamespacePorts; intended for local development clusters."
        }
      }
    },
    "argo": {
      "type": "object",
      "additionalProperties": false,
      "description": "Argo Workflows execution engine. Every pipeline runs as an Argo Workflow.",
      "properties": {
        "podPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "releaseTagRoutes": {
          "type": "object",
          "maxProperties": 256,
          "description": "Administrator-pinned canonical repository -> tag routes; selected documents retain their own size.",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pattern",
                "file"
              ],
              "properties": {
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "file": {
                  "type": "string",
                  "pattern": "^\\.oberth/[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.yaml$",
                  "not": {
                    "enum": [
                      ".oberth/build.yaml",
                      ".oberth/fragment.yaml",
                      ".oberth/schedule.yaml",
                      ".oberth/tests.yaml"
                    ]
                  }
                }
              }
            }
          }
        },
        "releaseWIF": {
          "type": "object",
          "additionalProperties": false,
          "description": "Public administrator release capabilities, empty disables federation. Never credentials.",
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            },
            "roles": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "service_account"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "pattern": "^projects/[0-9]+/locations/global/workloadIdentityPools/[a-z][a-z0-9-]*/providers/[a-z][a-z0-9-]*$"
                  },
                  "service_account": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*@[a-z][a-z0-9-]*\\.iam\\.gserviceaccount\\.com$"
                  }
                }
              },
              "maxProperties": 32
            },
            "repositories": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "templates"
                ],
                "properties": {
                  "service_account_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  },
                  "templates": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63,
                      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                    },
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63,
                      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                    }
                  },
                  "step_routes": {
                    "type": "object",
                    "description": "Exact template -> administrator route (file and tag pattern) required for each dedicated WIF-only identity.",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63,
                      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "pattern",
                        "file"
                      ],
                      "properties": {
                        "pattern": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "file": {
                          "type": "string",
                          "pattern": "^\\.oberth/[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.yaml$",
                          "not": {
                            "enum": [
                              ".oberth/build.yaml",
                              ".oberth/fragment.yaml",
                              ".oberth/schedule.yaml",
                              ".oberth/tests.yaml"
                            ]
                          }
                        }
                      }
                    }
                  },
                  "step_service_accounts": {
                    "type": "object",
                    "description": "Exact template -> dedicated WIF-only ServiceAccount, no secret grant or Vault role.",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63,
                      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253,
                      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                    }
                  }
                }
              }
            }
          },
          "anyOf": [
            {
              "maxProperties": 0
            },
            {
              "required": [
                "namespace",
                "roles",
                "repositories"
              ]
            }
          ]
        },
        "ciSecrets": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "serviceAccount": {
              "$ref": "#/definitions/kubernetesName",
              "description": "Branch-tier credentialed ServiceAccount; omit the key for oberth-argo-ci-secrets."
            },
            "vaultRole": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$",
              "description": "Branch-tier Vault role; omit the key for oberth-argo-ci-secrets."
            }
          }
        },
        "perRepoIdentities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/kubernetesName"
          }
        },
        "perRepoCIIdentities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/kubernetesName"
          }
        },
        "perStepIdentities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/kubernetesName"
          }
        },
        "namespace": {
          "type": "string",
          "description": "Namespace pipelines run in. Must differ from the release namespace: Vault Kubernetes-auth roles bind (namespace, ServiceAccount) pairs."
        },
        "pipelineServiceAccount": {
          "type": "string",
          "description": "Identity for pipeline templates without approved secrets. No Vault role, no token."
        },
        "credentialedServiceAccount": {
          "type": "string",
          "description": "Identity for templates with approved secrets. Carries a projected token for OpenBao login."
        },
        "executorServiceAccount": {
          "type": "string",
          "description": "Identity for Argo's own executor containers. Must differ from all pipeline identities."
        },
        "executorScratchSizeLimit": {
          "type": "string",
          "minLength": 1,
          "description": "Positive Kubernetes quantity for per-Pod emissary scratch on nonroot leaves. Defaults to 1Gi; the server validates the quantity at startup."
        },
        "workflowTTL": {
          "type": "integer",
          "minimum": 1
        },
        "vault": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "description": "OpenBao API base URL injected into credentialed containers as VAULT_ADDR. HTTPS required."
            },
            "credentialedRole": {
              "type": "string",
              "description": "OpenBao Kubernetes auth role, bound to exactly the credentialed ServiceAccount and namespace."
            },
            "caCert": {
              "type": "string",
              "description": "PEM trust anchors credentialed containers verify the Vault address against, delivered into the run's source volume and advertised as VAULT_CACERT. Certificates only; the server refuses a bundle carrying a private key."
            }
          },
          "additionalProperties": false
        },
        "sourceStorageClass": {
          "type": "string",
          "description": "Storage class for the per-run pipeline source volume. Empty selects the cluster default."
        },
        "goProxy": {
          "type": "object",
          "description": "Credential-free Go module proxy for private modules (#662). Serves the GOPROXY protocol read-only from Oberth's git cache.",
          "properties": {
            "allowNonDefaultBranchPseudoVersions": {
              "type": "boolean",
              "default": false,
              "description": "Allow pseudo-versions from non-default public branches and tags already permitted by module proxy policy. Default restricts pseudo-versions to default-branch ancestry."
            },
            "enabled": {
              "type": "boolean",
              "description": "Enable the read-only Go module proxy after configuring its owned namespace. Default: false."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "HTTPS port for the module proxy ClusterIP Service. Default: 8444."
            },
            "modulePrefix": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._/-]*$"
            },
            "repositoryPrefix": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]*$"
            },
            "upstream": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]*$"
            },
            "organization": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]*$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "required": [
                  "modulePrefix",
                  "upstream",
                  "organization"
                ],
                "properties": {
                  "modulePrefix": {
                    "minLength": 1
                  },
                  "upstream": {
                    "minLength": 1
                  },
                  "organization": {
                    "minLength": 1
                  }
                }
              }
            }
          ],
          "additionalProperties": false
        },
        "executionPlacementConfigMap": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "executionTargetConfigMap": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "executionTargetCredentialsSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        }
      }
    },
    "branches": {
      "type": "object",
      "additionalProperties": false,
      "description": "Branch deletion guards (#1490).",
      "properties": {
        "reserved": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^,]+$"
          },
          "description": "Branch globs (Go path.Match; * does not cross /) that no push or prune selector may delete; the default branch is always reserved. [] reserves only the default branch; null or absent keeps the server default main,master."
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "description": "Promotion governance knobs (#826).",
      "properties": {
        "grantMaxLifetime": {
          "type": "string",
          "description": "Maximum lifetime for promotion grants. Go duration string (e.g. 24h, 1h30m). Must be positive and at most 168h (7 days).",
          "pattern": "^[0-9]+(h|m|s|ms|us|ns)([0-9]+(h|m|s|ms|us|ns))*$"
        }
      }
    },
    "secretstore": {
      "type": "object",
      "additionalProperties": false,
      "description": "Secret-store-sourced release secrets from OpenBao: fetched at release admission, delivered into release-Job memory over exec, never stored in etcd or on disk.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "address": {
          "type": "string",
          "default": "https://openbao.openbao.svc:8200",
          "description": "OpenBao API base URL. Defaults to the standard in-cluster OpenBao Helm chart service; override if OpenBao is in a different namespace or external. HTTPS required unless insecureHTTPForDev.",
          "pattern": "^$|^https?://[^/?#@\\s]+(?:[/?][^#\\s]*)?$"
        },
        "k8sAuthMount": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "description": "Kubernetes auth mount path configured in OpenBao."
        },
        "role": {
          "type": "string",
          "description": "OpenBao Kubernetes auth role bound to the chart ServiceAccount."
        },
        "caCert": {
          "type": "string",
          "description": "Optional PEM bundle pinning the OpenBao TLS trust anchors (public material, delivered via ConfigMap)."
        },
        "insecureHTTPForDev": {
          "type": "boolean",
          "description": "DEVELOPMENT ONLY: allow a plain-HTTP OpenBao address."
        },
        "transit": {
          "type": "object",
          "additionalProperties": false,
          "description": "OpenBao Transit engine used for trusted-plan artifact envelopes. Enabled only over verified HTTPS.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mount": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$",
              "not": {
                "enum": [
                  ".",
                  "..",
                  "auth",
                  "sys",
                  "identity",
                  "cubbyhole"
                ]
              }
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$",
              "not": {
                "enum": [
                  ".",
                  ".."
                ]
              }
            }
          },
          "required": [
            "enabled",
            "mount",
            "key"
          ]
        },
        "kvMount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "description": "KV v2 mount backing the virtual oberth/upstream/ namespace: a declared oberth/upstream/<rest> path is fetched from '<kvMount>/data/upstream/<rest>'. Must match the mount setup-secretstore.sh enabled (its --kv-prefix).",
          "not": {
            "pattern": "^oberth/upstream(/|$)"
          }
        },
        "allowedPaths": {
          "type": "array",
          "uniqueItems": true,
          "description": "Administrator allowlist of system-namespace KV API paths repositories may declare through release SecretStoreSecrets. Org/repo-scoped release oberth/upstream/ paths are authorized structurally at admission and are never listed here. Trusted Plan/Apply paths use mandatory repository/phase namespaces and never consult this allowlist; entries addressing the upstream subtree are rejected.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
            "not": {
              "pattern": "^(auth|sys|identity|cubbyhole)/|^oberth/upstream(/|$)|(^|/)data/upstream(/|$)"
            }
          }
        },
        "createAuthDelegatorBinding": {
          "type": "boolean",
          "description": "Create the system:auth-delegator ClusterRoleBinding for TokenReview-based logins."
        },
        "external": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Override automatic external-store detection. External stores use login JWTs for TokenReview; null detects Kubernetes .svc endpoints."
        }
      },
      "required": [
        "enabled",
        "transit"
      ],
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "address": {
            "minLength": 1
          },
          "role": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        },
        "required": [
          "address",
          "role"
        ]
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaIdentity",
        "auditDomain",
        "witnessKeyInfo"
      ],
      "properties": {
        "schemaIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "auditDomain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "witnessKeyInfo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval",
        "keepNewestPerRef",
        "logs",
        "artifacts"
      ],
      "properties": {
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "keepNewestPerRef": {
          "type": "integer",
          "minimum": 0
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxAge",
            "budgetBytes"
          ],
          "properties": {
            "maxAge": {
              "type": "string",
              "minLength": 1
            },
            "budgetBytes": {
              "type": "integer",
              "minimum": 0
            },
            "limitBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxAge",
            "budgetBytes",
            "limitBytes"
          ],
          "properties": {
            "maxAge": {
              "type": "string",
              "minLength": 1
            },
            "budgetBytes": {
              "type": "integer",
              "minimum": 0
            },
            "limitBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "archivedRepositories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^/]+/[^/]+/[^/]+$"
      },
      "description": "Archived repository identities; releaseWIF entries for them are refused."
    },
    "sourceAccess": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "maxItems": 64,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
        }
      }
    }
  },
  "definitions": {
    "secretDataKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "kubernetesName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*$"
    },
    "optionalKubernetesName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*)?$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|ms|s|m|h)$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "pullPolicy"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourcePair"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memory",
            "ephemeral-storage"
          ],
          "properties": {
            "cpu": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "description": "Optional server CPU limit. Omit or set null to allow bursts."
            },
            "memory": {
              "type": "string",
              "minLength": 1
            },
            "ephemeral-storage": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory",
        "ephemeral-storage"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        },
        "ephemeral-storage": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
