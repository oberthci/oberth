{
  "kind": "Workflow",
  "apiVersion": "argoproj.io/v1alpha1",
  "metadata": {},
  "spec": {
    "templates": [
      {
        "name": "main",
        "inputs": {},
        "outputs": {},
        "metadata": {},
        "steps": [
          [
            {
              "name": "produce",
              "template": "producer",
              "arguments": {}
            }
          ],
          [
            {
              "name": "consume",
              "template": "leaf",
              "arguments": {},
              "withParam": "{{steps.produce.outputs.parameters.items}}",
              "hooks": {
                "exit": {
                  "template": "leaf",
                  "arguments": {}
                },
                "running": {
                  "template": "leaf",
                  "arguments": {},
                  "expression": "true"
                }
              }
            }
          ]
        ]
      },
      {
        "name": "leaf",
        "inputs": {},
        "outputs": {},
        "metadata": {},
        "container": {
          "name": "",
          "image": "example.test/image:1",
          "command": [
            "true"
          ],
          "resources": {}
        }
      },
      {
        "name": "producer",
        "inputs": {},
        "outputs": {
          "parameters": [
            {
              "name": "items",
              "valueFrom": {
                "path": "/tmp/items"
              }
            }
          ]
        },
        "metadata": {},
        "container": {
          "name": "",
          "image": "example.test/image:1",
          "command": [
            "true"
          ],
          "resources": {}
        }
      }
    ],
    "entrypoint": "main",
    "arguments": {}
  },
  "status": {
    "startedAt": null,
    "finishedAt": null
  }
}