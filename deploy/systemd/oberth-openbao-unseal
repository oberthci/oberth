#!/bin/sh
# Only paths and public cluster coordinates are read from the environment.
# systemd decrypts the TPM2-bound credential into a private runtime directory.
set -eu
: "${CREDENTIALS_DIRECTORY:?requires LoadCredentialEncrypted}"
: "${OPENBAO_CONTEXT:?set the context explicitly in the service drop-in}"
exec /usr/local/bin/oberth unseal \
 --context "$OPENBAO_CONTEXT" \
 --namespace "${OPENBAO_NAMESPACE:-openbao}" \
 --pod "${OPENBAO_POD:-openbao-0}" \
 --secrets-file "$CREDENTIALS_DIRECTORY/oberth-secrets"
