[Unit]
Description=Oberth: unseal OpenBao with a TPM2-bound credential
After=k3s.service kubelet.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/oberth-openbao-unseal
Environment=PATH=/usr/local/bin:/usr/bin:/bin
LoadCredentialEncrypted=oberth-secrets:/etc/oberth/unseal.cred
Restart=on-failure
RestartSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
