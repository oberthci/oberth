  "rules": [
    {
      "id": 1,
      "from": [
        "@components:except:C11"
      ],
      "to": [
        "cmd/oberth/**"
      ],
      "effect": "deny"
    },
    {
      "id": 2,
      "from": [
        "@C2",
        "@C3",
        "@C4",
        "@C5",
        "@C6",
        "@C7",
        "@C8",
        "@C10"
      ],
      "to": [
        "internal/api/**"
      ],
      "effect": "deny"
    },
    {
      "id": 3,
      "from": [
        "@C2"
      ],
      "to": [
        "@components:except:C2"
      ],
      "effect": "deny"
    },
    {
      "id": 4,
      "from": [
        "@C3",
        "@C5",
        "@C10",
        "@C11"
      ],
      "to": [
        "pkg/argoworkflow/**"
      ],
      "effect": "allow_if_listed",
      "symbols": {
        "C3": [
          "Prepare",
          "Policy",
          "AdmissionError",
          "ValidateNativeSchema"
        ],
        "C5": [
          "ValidateNativeSchema",
          "Template"
        ],
        "C10": [
          "ValidateNativeSchema"
        ],
        "C11": [
          "ValidateNativeSchema",
          "Decode",
          "Prepare",
          "Policy",
          "AdmissionError"
        ]
      }
    },
    {
      "id": 5,
      "from": [
        "@C5"
      ],
      "to": [
        "internal/service/**",
        "internal/app/**",
        "internal/installer/**",
        "internal/setuptui/**",
        "internal/cronsync/**",
        "internal/schedule/**",
        "internal/cron/**"
      ],
      "effect": "deny"
    },
    {
      "id": 6,
      "from": [
        "@C2",
        "@C3",
        "@C10"
      ],
      "to": [
        "internal/gitcache/**"
      ],
      "effect": "deny"
    },
    {
      "id": 7,
      "from": [
        "@C7"
      ],
      "to": [
        "@C1",
        "@C2",
        "@C3",
        "@C5",
        "@C6",
        "@C8",
        "@C9",
        "@C10",
        "@C11"
      ],
      "effect": "deny"
    },
    {
      "id": 8,
      "from": [
        "@C1"
      ],
      "to": [
        "internal/runlog"
      ],
      "effect": "allow_if_listed",
      "symbols": {
        "*": [
          "Filter",
          "Meta"
        ]
      }
    },
    {
      "id": 9,
      "from": [
        "@C3"
      ],
      "to": [
        "internal/cronsync/**",
        "internal/installer/**"
      ],
      "effect": "deny"
    },
    {
      "id": 10,
      "from": [
        "@shared"
      ],
      "to": [
        "@components"
      ],
      "effect": "deny"
    },
    {
      "id": 11,
      "from": [
        "@C9"
      ],
      "to": [
        "internal/client",
        "internal/stateport"
      ],
      "effect": "allow_if_listed"
    },
    {
      "id": 12,
      "from": [
        "@C12",
        "@C14"
      ],
      "to": [
        "@components"
      ],
      "effect": "deny"
    },
    {
      "id": 13,
      "from": [
        "**"
      ],
      "to": [
        "pkg/pipeline/**",
        "internal/runprogress/**",
        "internal/recordjson/**",
        "internal/artifacts/**",
        "internal/sourceport/**"
      ],
      "effect": "deny",
      "transitive": true
    },
    {
      "id": 14,
      "from": [
        "@components",
        "@shared"
      ],
      "to": [
        "test/**",
        "hack/**"
      ],
      "effect": "deny"
    },
    {
      "id": 15,
      "from": [
        "@components:except:C4",
        "@shared",
        "pkg/argoworkflow/defaults/**",
        "pkg/argoworkflow/specsize/**"
      ],
      "to": [
        "internal/admissioncontract"
      ],
      "effect": "allow_if_listed",
      "symbols": {
        "*": [
          "AccountEvidence",
          "EvidenceState",
          "Finding",
          "GrantEvidence",
          "IdentityEvidence",
          "IdentityRequest",
          "MaxCapabilityKinds",
          "MaxDocumentBytes",
          "MaxNestingDepth",
          "MaxPinnedDestinations",
          "MaxPlanBytes",
          "MaxPlanEntries",
          "MaxPlannerVisits",
          "MaxScheduleEntryBytes",
          "MaxSecretPaths",
          "MaxSourceSpecBytes",
          "Mode",
          "ModeInspect",
          "ModeSubmit",
          "Plan",
          "PlanEntry",
          "PrepareHooks",
          "PrepareRequest",
          "PreparedAdmission",
          "PreparedView",
          "SealError",
          "StateLiveRequired",
          "StateUnknown",
          "StateVerified",
          "TemplateSnapshot",
          "TransformInput"
        ],
        "C3": [
          "ReleaseFacts",
          "IsReleaseParameter"
        ],
        "C5": [
          "ChildSpecDigest",
          "ScheduleParent"
        ],
        "C11": [
          "ReleaseFacts"
        ]
      }
    }
  ],
  "fixture_only": [
    {
      "from": [
        "hack/upgrade-e2e/fixture/**"
      ],
      "to": [
        "internal/store",
        "internal/model",
        "pkg/argoworkflow",
        "internal/testdb",
        "internal/storetest"
      ],
      "build_scope": "disposable fixture and its tests only"
    },
    {
      "from": [
        "hack/testdata/**"
      ],
      "to": [
        "internal/app",
        "internal/argojob",
        "pkg/argoworkflow",
        "pkg/argoworkflow/defaults"
      ],
      "build_scope": "named compiler-overlay fixture only"
    }
  ],
