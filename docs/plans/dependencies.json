      "internal/setuptui/**",
      "internal/secretstore/**",
      "internal/kubeconfig/**"
    ],
    "C10": [
      "internal/cronsync/**",
      "internal/schedule/**"
    ],
    "C11": [
      "cmd/oberth/**",
      "internal/client/**",
      "internal/restartretry/**"
