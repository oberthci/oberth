# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG SOURCE_DATE_EPOCH
FROM golang:1.26.5-alpine3.23@sha256:622e56dbc11a8cfe87cafa2331e9a201877271cbff918af53d3be315f3da88cc AS build
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/oberth-runner ./cmd/oberth-runner
COPY internal/gitoid ./internal/gitoid
COPY internal/runner ./internal/runner
COPY pkg/periapsis ./pkg/periapsis
ARG TARGETOS=linux
ARG TARGETARCH
RUN test "$TARGETOS/$TARGETARCH" = linux/amd64 \
    && CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
       go build -trimpath -buildvcs=false -ldflags='-s -w -buildid=' \
       -o /out/oberth-runner ./cmd/oberth-runner

FROM alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40 AS runner
RUN apk add --no-cache \
      bash=5.3.3-r1 \
      ca-certificates=20260611-r0 \
      curl=8.20.0-r0 \
      git=2.52.0-r0 \
    && rm -f /var/log/apk.log
COPY --from=build /out/oberth-runner /usr/local/bin/oberth-runner
RUN mkdir -p /cache/gomod /cache/gobuild /work /secrets /tmp/oberth-tools/bin \
    && chown -R 65534:65534 /cache /work /secrets /tmp/oberth-tools
ENV HOME=/tmp \
    PATH=/tmp/oberth-tools/bin:/usr/local/bin:/usr/bin:/bin \
    GOTOOLCHAIN=local \
    GOMODCACHE=/cache/gomod \
    GOCACHE=/cache/gobuild
USER 65534:65534
RUN --network=none test "$(id -u):$(id -g)" = 65534:65534 \
    && test -x /usr/local/bin/oberth-runner \
    && test -w /tmp/oberth-tools/bin
ENTRYPOINT ["/usr/local/bin/oberth-runner"]
