#!/bin/sh
# Download only immutable versioned artifacts, authenticated by the plugin key.
set -eu
umask 077
fail() { printf 'fetch-oberth: %s\n' "$1" >&2; exit 1; }
[ "$#" -le 1 ] || fail 'usage: fetch-oberth [vMAJOR.MINOR.PATCH]'
version=${1:-latest}
origin=https://releases.oberth.ci/oberth
release_public_key_sha256=036dd71c9d3c07a19bff06d4392874014573f695620ac8554d9df175094c4a31
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || fail 'cannot locate the plugin'
key=$script_dir/../pins/release-cosign.pub
for tool in openssl awk grep mktemp uname; do
    command -v "$tool" >/dev/null 2>&1 || fail "required tool is missing: $tool"
done
if command -v sha256sum >/dev/null 2>&1; then
    hash() { sha256sum "$1" | awk '{print $1}'; }
elif command -v shasum >/dev/null 2>&1; then
    hash() { shasum -a 256 "$1" | awk '{print $1}'; }
else
    fail 'install sha256sum (coreutils) or shasum before fetching Oberth'
fi
[ -f "$key" ] && [ ! -L "$key" ] || fail 'the plugin release public key is missing or unsafe'
[ "$(hash "$key")" = "$release_public_key_sha256" ] || fail 'the plugin release public key does not match its pin'
if command -v curl >/dev/null 2>&1; then
    download() {
        curl -q --fail --silent --location --proto '=https' --proto-redir '=https' \
            --tlsv1.2 --connect-timeout 10 --max-time 300 --max-filesize "$3" \
            --output "$2" "$1" 2>/dev/null || fail 'release download failed; check network access and the version'
    }
elif command -v wget >/dev/null 2>&1; then
    download() {
        wget --no-config --quiet --https-only --timeout=120 --tries=2 \
            --max-redirect=5 -O "$2" "$1" 2>/dev/null || fail 'release download failed; check network access and the version'
        [ "$(wc -c <"$2")" -le "$3" ] || fail 'release download exceeds the size limit'
    }
else
    fail 'install curl or wget before fetching Oberth'
fi
case $(uname -s) in Linux) os=linux;; Darwin) os=darwin;; *) fail 'supported systems are Linux and macOS';; esac
case $(uname -m) in x86_64|amd64) arch=amd64;; aarch64|arm64) arch=arm64;; *) fail 'supported architectures are amd64 and arm64';; esac
work=$(mktemp -d "${TMPDIR:-/tmp}/oberth-fetch.XXXXXXXX") || fail 'cannot create a private download directory'
stage=
lock=
cleanup() {
    rm -rf -- "$work"
    if [ -n "$stage" ]; then rm -rf -- "$stage"; fi
    if [ -n "$lock" ]; then rmdir -- "$lock"; fi
}
trap cleanup 0
trap 'exit 1' 1 2 15
if [ "$version" = latest ]; then
    download "$origin/latest/VERSION" "$work/VERSION" 128
    version=$(cat "$work/VERSION")
fi
# No path separators, shell syntax or option prefixes can enter a release path.
case "$version" in *[!0-9A-Za-z.+-]*) fail 'version must be a v-prefixed semantic version';; esac
[ "${#version}" -le 128 ] && printf '%s\n' "$version" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$' || fail 'version must be a v-prefixed semantic version'
artifact=oberth-$os-$arch
download "$origin/$version/SHA256SUMS" "$work/SHA256SUMS" 8192
download "$origin/$version/SHA256SUMS.sig" "$work/SHA256SUMS.sig" 72
openssl dgst -sha256 -verify "$key" -signature "$work/SHA256SUMS.sig" \
    "$work/SHA256SUMS" >/dev/null 2>&1 || fail 'release checksum signature was refused; nothing was installed'
# Validate the entire manifest without passing its paths to a checksum tool.
# One digest per supported binary and exactly this version's chart is required.
expected=$(awk -v artifact="$artifact" -v chart="oberth-${version#v}.tgz" '
    NF != 2 || length($1) != 64 || $1 !~ /^[0-9a-f]+$/ || seen[$2]++ { bad=1 }
    $2 !~ /^oberth-(linux|darwin)-(amd64|arm64)$/ && $2 != chart { bad=1 }
    $2 == artifact { digest=$1 }
    END { if (bad || NR != 5 || !digest) exit 1; print digest }
' "$work/SHA256SUMS") || fail 'release checksum manifest was refused; nothing was installed'
download "$origin/$version/$artifact" "$work/binary" 536870912
[ "$(hash "$work/binary")" = "$expected" ] || fail 'release binary checksum was refused; nothing was installed'
[ -s "$work/binary" ] || fail 'the release binary is empty'
[ -n "${HOME:-}" ] || fail 'HOME must name the user home directory'
bin=$HOME/.local/bin
mkdir -p -- "$bin" || fail 'cannot create ~/.local/bin'
[ ! -d "$bin/oberth" ] && [ ! -L "$bin/oberth-$version" ] && [ ! -d "$bin/oberth-$version" ] || fail 'installation target is an unsafe file type'
mkdir -- "$bin/.oberth-fetch-lock" 2>/dev/null || fail 'another fetch is installing; retry when it finishes'
lock=$bin/.oberth-fetch-lock
stage=$(mktemp -d "$bin/.oberth-fetch.XXXXXXXX") || fail 'cannot stage the verified binary'
cp -- "$work/binary" "$stage/binary"
chmod 0755 "$stage/binary"
ln -s "oberth-$version" "$stage/oberth"
mv -f -- "$stage/binary" "$bin/oberth-$version"
mv -f -- "$stage/oberth" "$bin/oberth"
printf 'Verified Oberth %s installed: %s/oberth\n' "$version" "$bin"
